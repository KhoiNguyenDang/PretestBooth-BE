generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Domain-specific relations (optional 1-1) - Role-specific profiles
  studentProfile           Student?           @relation("UserStudent")
  lecturerProfile          Lecturer?          @relation("UserLecturer")

  // Existing identity relations
  auth                     UserAuth?          @relation("UserAuth")
  kycProfile               UserKyc?           @relation("UserKyc")
  faceEmbeddingRecord      UserFaceEmbedding? @relation("UserFaceEmbedding")
  pointAccount             PointAccount?      @relation("PointAccount")
  reviewedKycProfiles      UserKyc[]          @relation("UserKycReviewer")

  // Cross-role relations (will migrate to Student/Lecturer but kept for backward compat)
  bookings                   Booking[]                      @relation("UserBooking")
  boothStatusLogs            BoothStatusLog[]
  createdExams               Exam[]                         @relation("ExamCreator")
  examSessions               ExamSession[]                  @relation("UserExamSession")
  pointTransactions          PointTransaction[]             @relation("UserPointTransaction")
  bookingCheckinAttempts     BookingCheckinAttempt[]         @relation("UserCheckinAttempt")
  practiceSessions           PracticeSession[]              @relation("UserPracticeSession")
  createdProblems            Problem[]                      @relation("ProblemCreator")
  createdQuestions           Question[]                     @relation("QuestionCreator")
  reviewedQuestionSessions   QuestionReviewSession[]        @relation("QuestionReviewSessionReviewer")
  questionReviewActions      QuestionReviewAction[]         @relation("QuestionReviewActionReviewer")
  grantedLecturerPermissions LecturerPermissionAssignment[] @relation("LecturerPermissionGrantor")
  createdLecturerRoles       LecturerRole[]                 @relation("LecturerRoleCreator")
  proctoringEvents           ProctoringEvent[]
  submissions                Submission[]
  
  // Cross-role relationsfor lecturers assigning roles
  assignedLecturerRoles      Lecturer[]                     @relation("LecturerAssigner")

  @@index([email])
  @@index([role])
}

model UserAuth {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  password                String
  refreshToken            String?
  isEmailVerified         Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  resetPasswordCode       String?
  resetPasswordExpiry     DateTime?
  isLocked                Boolean   @default(false)
  lockedAt                DateTime?
  lockedReason            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation("UserAuth", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isEmailVerified])
  @@index([isLocked])
}

model UserKyc {
  id                             String                @id @default(uuid())
  userId                         String                @unique
  kycStatus                      KycStatus             @default(NOT_STARTED)
  kycRegisteredAt                DateTime?
  kycVerifiedAt                  DateTime?
  kycLastAttemptAt               DateTime?
  kycFaceImageUrl                String?
  kycStudentImageUrl             String?
  kycManualReviewStatus          KycManualReviewStatus @default(NOT_REQUESTED)
  kycManualReviewRequestedAt     DateTime?
  kycManualReviewRequestedReason String?
  kycManualReviewReviewedAt      DateTime?
  kycManualReviewedByUserId      String?
  kycManualReviewRejectionReason String?
  kycManualReviewNotes           String?
  kycConsentVersion              String?
  kycConsentedAt                 DateTime?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  reviewedByUser                 User?                 @relation("UserKycReviewer", fields: [kycManualReviewedByUserId], references: [id], onDelete: SetNull)
  user                           User                  @relation("UserKyc", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kycStatus])
  @@index([kycManualReviewStatus])
  @@index([kycManualReviewedByUserId])
}

model UserFaceEmbedding {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  faceEmbedding          Json?
  faceEmbeddingModel     String?
  faceEmbeddingVersion   String?
  faceEmbeddingNorm      Float?
  faceEmbeddingUpdatedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation("UserFaceEmbedding", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Role-specific tables (Class Table Inheritance pattern)
model Student {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  studentCode               String?   @unique
  className                 String?
  dateOfBirth               DateTime? @db.Date
  studentCardImageUrl       String?
  studentCardVerifiedAt     DateTime?
  studentCardFaceMatchScore Float?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation("UserStudent", fields: [userId], references: [id], onDelete: Cascade)

  // Relations from existing User.bookings, examSessions, etc.
  bookings              Booking[]
  examSessions          ExamSession[]
  submissions           Submission[]
  practiceSessions      PracticeSession[]
  checkinAttempts       BookingCheckinAttempt[]
  pointTransactions     PointTransaction[]        @relation("StudentPointTransaction")

  @@index([userId])
  @@index([studentCode])
}

model Lecturer {
  id                           String    @id @default(uuid())
  userId                       String    @unique
  lecturerRoleId               String?
  lecturerRoleAssignedAt       DateTime?
  lecturerRoleAssignedByUserId String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user               User          @relation("UserLecturer", fields: [userId], references: [id], onDelete: Cascade)
  lecturerRole       LecturerRole? @relation("LecturerRole", fields: [lecturerRoleId], references: [id], onDelete: SetNull)
  assignedByUser     User?         @relation("LecturerAssigner", fields: [lecturerRoleAssignedByUserId], references: [id], onDelete: SetNull)
  lecturerPermissions LecturerPermissionAssignment[] @relation("LecturerPermissionOwner")

  // Relations from existing User tables
  createdProblems    Problem[]       @relation("ProblemLecturerCreator")
  createdQuestions   Question[]      @relation("QuestionLecturerCreator")
  createdExams       Exam[]          @relation("ExamLecturerCreator")
  reviewActions      QuestionReviewAction[]

  @@index([userId])
  @@index([lecturerRoleId])
  @@index([lecturerRoleAssignedByUserId])
}

model PointAccount {
  id          String   @id @default(uuid())
  userId      String   @unique
  totalPoints Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation("PointAccount", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LecturerPermissionAssignment {
  id              String             @id @default(uuid())
  lecturerId      String
  permission      LecturerPermission
  grantedByUserId String?
  grantedAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lecturer        Lecturer           @relation("LecturerPermissionOwner", fields: [lecturerId], references: [id], onDelete: Cascade)
  grantedByUser   User?              @relation("LecturerPermissionGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([lecturerId, permission])
  @@index([lecturerId])
  @@index([permission])
  @@index([grantedByUserId])
}

model LecturerRole {
  id              String                   @id @default(uuid())
  code            String                   @unique
  name            String
  description     String?
  priority        Int                      @unique
  isActive        Boolean                  @default(true)
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdByUser   User?                    @relation("LecturerRoleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lecturers       Lecturer[]               @relation("LecturerRole")
  permissions     LecturerRolePermission[]

  @@index([priority])
  @@index([isActive])
  @@index([createdByUserId])
}

model LecturerRolePermission {
  id         String             @id @default(uuid())
  roleId     String
  permission LecturerPermission
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  role       LecturerRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
}

model Problem {
  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  description         String
  difficulty          Difficulty            @default(MEDIUM)
  starterCode         Json?
  constraints         String?
  hints               String[]
  timeLimit           Int                   @default(1000)
  memoryLimit         Int                   @default(256)
  functionName        String                @default("solution")
  inputTypes          String[]              @default([])
  outputType          String                @default("void")
  argNames            String[]              @default([])
  totalSubmissions    Int                   @default(0)
  acceptedSubmissions Int                   @default(0)
  isPublished         Boolean               @default(false)
  subjectId           String?
  topicId             String?
  categoryId          String?
  creatorId           String
  lecturerId          String?  // New FK for role-based migration
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  examItems           ExamItem[]            @relation("ProblemExamItems")
  practiceItems       PracticeSessionItem[]
  category            Category?             @relation(fields: [categoryId], references: [id])
  creator             User                  @relation("ProblemCreator", fields: [creatorId], references: [id])
  lecturerCreator     Lecturer?             @relation("ProblemLecturerCreator", fields: [lecturerId], references: [id])
  subject             Subject?              @relation(fields: [subjectId], references: [id])
  topic               Topic?                @relation(fields: [topicId], references: [id])
  submissions         Submission[]
  testCases           TestCase[]

  @@index([difficulty])
  @@index([isPublished])
  @@index([creatorId])
  @@index([lecturerId])
  @@index([subjectId])
  @@index([topicId])
  @@index([categoryId])
}

model TestCase {
  id             String   @id @default(uuid())
  input          String
  expectedOutput String
  explanation    String?
  isHidden       Boolean  @default(false)
  isSample       Boolean  @default(false)
  order          Int      @default(0)
  problemId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([isHidden])
  @@index([isSample])
}

model Submission {
  id              String           @id @default(uuid())
  language        String
  languageVersion String?
  sourceCode      String
  status          SubmissionStatus @default(PENDING)
  totalTestCases  Int              @default(0)
  passedTestCases Int              @default(0)
  failedTestCases Int              @default(0)
  executionTime   Int?
  networkTime     Int?
  totalTime       Int?
  compileOutput   String?
  errorMessage    String?
  testCaseResults Json?
  userId          String
  studentId       String?  // New FK for role-based migration
  problemId       String
  createdAt       DateTime         @default(now())
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([problemId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, problemId])
}

model Subject {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  exams       Exam[]
  problems    Problem[]
  questions   Question[]
  topics      Topic[]
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  subjectId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exams     Exam[]
  problems  Problem[]
  questions Question[]
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Question {
  id             String                  @id @default(uuid())
  content        String
  imageUrl       String?
  questionType   QuestionType            @default(SINGLE_CHOICE)
  classification QuestionClassification  @default(EXAM)
  difficulty     Difficulty              @default(MEDIUM)
  correctAnswer  String?
  explanation    String?
  isPublished    Boolean                 @default(false)
  lastReviewedAt DateTime?
  reviewNotes    String?
  qualityScore   Int?
  usageCount     Int                     @default(0)
  estimatedTime  Int?
  subjectId      String
  topicId        String?
  categoryId     String?
  creatorId      String
  lecturerId     String?  // New FK for role-based migration
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  examItems      ExamItem[]              @relation("QuestionExamItems")
  practiceItems  PracticeSessionItem[]
  category       Category?               @relation(fields: [categoryId], references: [id])
  creator        User                    @relation("QuestionCreator", fields: [creatorId], references: [id])
  lecturerCreator Lecturer?              @relation("QuestionLecturerCreator", fields: [lecturerId], references: [id])
  subject        Subject                 @relation(fields: [subjectId], references: [id])
  topic          Topic?                  @relation(fields: [topicId], references: [id])
  choices        QuestionChoice[]
  reviewSessions QuestionReviewSession[]

  @@index([questionType])
  @@index([classification])
  @@index([difficulty])
  @@index([isPublished])
  @@index([subjectId])
  @@index([topicId])
  @@index([categoryId])
  @@index([creatorId])
  @@index([lecturerId])
}

model QuestionReviewSession {
  id           String                 @id @default(uuid())
  quarter      Int
  year         Int
  academicYear String
  startDate    DateTime
  endDate      DateTime
  status       QuestionReviewStatus   @default(PENDING)
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  questionId   String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  question     Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewer     User?                  @relation("QuestionReviewSessionReviewer", fields: [reviewedBy], references: [id])
  actions      QuestionReviewAction[]

  @@unique([quarter, year, questionId])
  @@index([quarter, year, status])
  @@index([reviewedBy])
  @@index([questionId])
}

model QuestionReviewAction {
  id         String                @id @default(uuid())
  sessionId  String
  status     QuestionReviewStatus
  notes      String?
  reviewedBy String
  lecturerId String?  // New FK for role-based migration
  reviewedAt DateTime              @default(now())
  createdAt  DateTime              @default(now())
  session    QuestionReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer   User                  @relation("QuestionReviewActionReviewer", fields: [reviewedBy], references: [id], onDelete: Cascade)
  lecturer   Lecturer?             @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([reviewedBy])
  @@index([lecturerId])
  @@index([reviewedAt])
}

model QuestionChoice {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  questionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Exam {
  id                                String         @id @default(uuid())
  title                             String
  description                       String?
  // Exam type: determines who can access (practice bookers vs exam bookers)
  type                              BookingType    @default(EXAM)
  questionCount                     Int            @default(0)
  problemCount                      Int            @default(0)
  duration                          Int            @default(60)
  difficulty                        Difficulty?
  includeProblemsRelatedToQuestions Boolean        @default(false)
  shuffleQuestions                  Boolean        @default(true)
  shuffleChoices                    Boolean        @default(true)
  subjectId                         String?
  topicId                           String?
  isPublished                       Boolean        @default(false)
  creatorId                         String
  lecturerId                        String?  // New FK for role-based migration
  createdAt                         DateTime       @default(now())
  updatedAt                         DateTime       @updatedAt
  visibility                        ExamVisibility @default(PRIVATE)
  publishAt                         DateTime?
  publishedAt                       DateTime?
  allowStudentReviewResults         Boolean        @default(false)
  passingScoreAbsolute              Float?
  creator                           User           @relation("ExamCreator", fields: [creatorId], references: [id])
  lecturerCreator                   Lecturer?      @relation("ExamLecturerCreator", fields: [lecturerId], references: [id])
  subject                           Subject?       @relation(fields: [subjectId], references: [id])
  topic                             Topic?         @relation(fields: [topicId], references: [id])
  items                             ExamItem[]
  sessions                          ExamSession[]

  @@index([creatorId])
  @@index([lecturerId])
  @@index([subjectId])
  @@index([topicId])
  @@index([isPublished])
  @@index([visibility])
  @@index([publishAt])
}

model ExamItem {
  id             String              @id @default(uuid())
  examId         String
  questionId     String?
  problemId      String?
  section        ExamSection
  order          Int                 @default(0)
  points         Float               @default(1.0)
  createdAt      DateTime            @default(now())
  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  problem        Problem?            @relation("ProblemExamItems", fields: [problemId], references: [id])
  question       Question?           @relation("QuestionExamItems", fields: [questionId], references: [id])
  sessionAnswers ExamSessionAnswer[]

  @@unique([examId, questionId])
  @@unique([examId, problemId])
  @@index([examId])
  @@index([section])
}

model ExamSession {
  id                          String                  @id @default(uuid())
  examId                      String
  userId                      String
  studentId                   String?  // New FK for role-based migration
  bookingId                   String?
  isPretestSession            Boolean                 @default(false)
  pretestAttemptNumber        Int?
  pretestAssignmentMode       PretestAssignmentMode?
  pretestThresholdSource      PretestThresholdSource?
  pretestSourceExamId         String?
  appliedPassingScoreAbsolute Float?
  passed                      Boolean?
  seed                        Int
  startedAt                   DateTime                @default(now()) @db.Timestamptz(3)
  finishedAt                  DateTime?               @db.Timestamptz(3)
  score                       Float?
  maxScore                    Float?
  status                      ExamSessionStatus       @default(IN_PROGRESS)
  resultPublicationStatus     ResultPublicationStatus @default(PENDING_REVIEW)
  resultPublishedAt           DateTime?               @db.Timestamptz(3)
  resultLastUpdatedAt         DateTime?               @db.Timestamptz(3)
  resultRevisionCount         Int                     @default(0)
  createdAt                   DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt                   DateTime                @default(now()) @db.Timestamptz(3)
  exam                        Exam                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                        User                    @relation("UserExamSession", fields: [userId], references: [id], onDelete: Cascade)
  student                     Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  booking                     Booking?                @relation("ExamSessionBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  answers                     ExamSessionAnswer[]
  gradeAudits                 ExamSessionGradeAudit[]
  proctoringEvents            ProctoringEvent[]

  @@index([examId, userId])
  @@index([examId])
  @@index([userId])
  @@index([studentId])
  @@index([status])
  @@index([resultPublicationStatus])
  @@index([expiresAt])
  @@index([bookingId])
  @@index([userId, isPretestSession])
  @@index([bookingId, isPretestSession])
}

model ExamSessionAnswer {
  id                   String      @id @default(uuid())
  sessionId            String
  examItemId           String
  selectedChoiceIds    String[]
  textAnswer           String?
  submissionId         String?
  sourceCode           String?
  language             String?
  languageVersion      String?
  isCorrect            Boolean?
  score                Float?
  aiSuggestedIsCorrect Boolean?
  aiSuggestedScore     Float?
  aiGradingRationale   String?
  aiGradedAt           DateTime?
  manualIsCorrect      Boolean?
  manualScore          Float?
  reviewerFeedback     String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  examItem             ExamItem    @relation(fields: [examItemId], references: [id], onDelete: Cascade)
  session              ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, examItemId])
  @@index([sessionId])
  @@index([examItemId])
  @@index([reviewedByUserId])
  @@index([reviewedAt])
}

model ExamSessionGradeAudit {
  id                String           @id @default(uuid())
  sessionId         String
  examItemId        String?
  action            GradeAuditAction
  previousScore     Float?
  newScore          Float?
  previousIsCorrect Boolean?
  newIsCorrect      Boolean?
  feedback          String?
  actorUserId       String?
  actorRole         Role?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  session           ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([action])
  @@index([actorUserId])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  level       Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  problems    Problem[]
  questions   Question[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([level])
}

model Booth {
  id                     String           @id @default(uuid())
  name                   String           @unique
  description            String?
  status                 BoothStatus      @default(ACTIVE)
  location               String?
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)
  activationOtpAttempts  Int              @default(0)
  activationOtpExpiresAt DateTime?        @db.Timestamptz(3)
  activationOtpHash      String?
  activationOtpUsedAt    DateTime?        @db.Timestamptz(3)
  code                   String?          @unique
  sessionActivatedAt     DateTime?        @db.Timestamptz(3)
  sessionTokenHash       String?
  bookings               Booking[]
  statusLogs             BoothStatusLog[]

  @@index([status])
}

model BoothStatusLog {
  id              String      @id @default(uuid())
  boothId         String
  fromStatus      BoothStatus
  toStatus        BoothStatus
  note            String
  changedByUserId String?
  changedAt       DateTime    @default(now()) @db.Timestamptz(3)
  booth           Booth       @relation(fields: [boothId], references: [id], onDelete: Cascade)
  changedByUser   User?       @relation(fields: [changedByUserId], references: [id])

  @@index([boothId, changedAt])
  @@index([changedByUserId])
}

model BookingDurationOption {
  id              String      @id @default(uuid())
  type            BookingType
  durationMinutes Int
  isActive        Boolean     @default(true)
  displayOrder    Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([type, durationMinutes])
  @@index([type, isActive])
}

model SystemSetting {
  key             String   @id
  value           String
  description     String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedByUserId])
}

model Booking {
  id                       String        @id @default(uuid())
  userId                   String
  studentId                String?  // New FK for role-based migration
  boothId                  String
  type                     BookingType
  date                     DateTime      @db.Date
  startTime                DateTime      @db.Timestamptz(3)
  endTime                  DateTime      @db.Timestamptz(3)
  durationMinutes          Int
  bufferMinutes            Int           @default(15)
  status                   BookingStatus @default(CONFIRM)
  checkedInAt              DateTime?     @db.Timestamptz(3)
  checkedOutAt             DateTime?     @db.Timestamptz(3)
  checkinStatus            CheckinStatus @default(PENDING)
  checkinSimilarityScore   Float?
  checkinThreshold         Float         @default(0.6)
  checkinVerifiedAt        DateTime?     @db.Timestamptz(3)
  checkinAttemptCount      Int           @default(0)
  fallbackAppliedAt        DateTime?     @db.Timestamptz(3)
  fallbackEvidenceImageUrl String?

  // Relations - exam/practice sessions that reference this booking
  examSessions     ExamSession[]           @relation("ExamSessionBooking")
  practiceSessions PracticeSession[]       @relation("PracticeSessionBooking")
  checkinAttempts  BookingCheckinAttempt[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  booth   Booth    @relation(fields: [boothId], references: [id])
  user    User     @relation("UserBooking", fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([boothId, date])
  @@index([date, startTime])
  @@index([status])
  @@index([boothId, startTime, endTime])
  @@index([checkinStatus])
}

model BookingCheckinAttempt {
  id               String   @id @default(uuid())
  bookingId        String
  userId           String
  studentId        String?  // New FK for role-based migration
  similarityScore  Float
  threshold        Float    @default(0.6)
  isMatch          Boolean
  livenessPassed   Boolean  @default(true)
  failReason       String?
  evidenceImageUrl String?
  verifierDeviceId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user             User     @relation("UserCheckinAttempt", fields: [userId], references: [id], onDelete: Cascade)
  student          Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([userId, createdAt])
  @@index([studentId, createdAt])
  @@index([isMatch])
}

model PointTransaction {
  id            String    @id @default(uuid())
  userId        String
  studentId     String?  // New FK for role-based migration
  type          PointType
  points        Int
  reason        String
  bookingId     String?
  examSessionId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation("UserPointTransaction", fields: [userId], references: [id])
  student       Student?  @relation("StudentPointTransaction", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([type])
  @@index([createdAt])
}

model ProctoringEvent {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Either examSessionId or practiceSessionId should be set
  examSessionId String?
  examSession   ExamSession? @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  practiceSessionId String?
  practiceSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  eventType    String // "TAB_SWITCH", "WINDOW_BLUR", "COPY_PASTE", "FULLSCREEN_EXIT"
  warningLevel Int    @default(1) // 1 = mild warning, 2 = severe, 3 = exam cancelled
  metadata     Json? // Additional event data

  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([examSessionId])
  @@index([practiceSessionId])
  @@index([userId])
  @@index([eventType])
}

model PracticeSession {
  id               String                @id @default(uuid())
  userId           String
  studentId        String?  // New FK for role-based migration
  bookingId        String?
  duration         Int
  totalItems       Int
  difficulty       Difficulty?
  subjectId        String?
  topicId          String?
  categoryId       String?
  startedAt        DateTime              @default(now()) @db.Timestamptz(3)
  finishedAt       DateTime?             @db.Timestamptz(3)
  score            Float?
  maxScore         Float?
  status           PracticeSessionStatus @default(IN_PROGRESS)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  user             User                  @relation("UserPracticeSession", fields: [userId], references: [id])
  student          Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  booking          Booking?              @relation("PracticeSessionBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  items            PracticeSessionItem[]
  proctoringEvents ProctoringEvent[]

  @@index([userId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([bookingId])
}

model PracticeSessionItem {
  id         String                 @id @default(uuid())
  sessionId  String
  questionId String?
  problemId  String?
  order      Int                    @default(0)
  points     Float                  @default(1.0)
  createdAt  DateTime               @default(now())
  answers    PracticeSessionAnswer?
  problem    Problem?               @relation(fields: [problemId], references: [id])
  question   Question?              @relation(fields: [questionId], references: [id])
  session    PracticeSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PracticeSessionAnswer {
  id                String              @id @default(uuid())
  itemId            String              @unique
  selectedChoiceIds String[]
  textAnswer        String?
  sourceCode        String?
  language          String?
  languageVersion   String?
  submissionId      String?
  isCorrect         Boolean?
  score             Float?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  item              PracticeSessionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

